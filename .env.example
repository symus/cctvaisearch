# Copy to .env (repo root or backend/) and edit. All settings are optional.

# Where the database, thumbnails, reference photos, clips and indexes are stored.
# Original recordings are never copied here. Use a drive with free space.
# CCTV_DATA_DIR=D:\CCTVSearchData

# Keep 127.0.0.1: binding to 0.0.0.0 exposes biometric search to your network.
CCTV_HOST=127.0.0.1
CCTV_PORT=8000

# Full paths if FFmpeg is not on PATH.
# CCTV_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# CCTV_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# File types picked up by folder scans.
CCTV_VIDEO_EXTENSIONS=.mp4,.avi,.mkv,.mov,.m4v

# Frames sampled per second when indexing (Milestone 3+).
CCTV_SAMPLE_FPS=1.0

# Concurrent background jobs. Keep at 1 on a 16 GB machine.
CCTV_MAX_CONCURRENT_JOBS=1
